{
  "format": "context-ledger-scenarios",
  "version": 1,
  "note": "Frozen prompts and expected tool-call paths. Unittest checks shape and seed replay only. Model-run eval is manual; report each scenario, no aggregate PASS.",
  "scenarios": [
    {
      "id": "routine-rename",
