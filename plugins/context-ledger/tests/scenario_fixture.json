      "expected_save": false
    },
    {
      "id": "useful-failure-no-prior",
      "path": "observe",
      "prompt": "Offline wheelhouse install failed because a wheel was missing. No prior record exists.",
      "expected_tools": ["record"],
      "expected_save": true,
      "kind": "observation"
