{
  "mcpServers": {
    "context-ledger": {
      "type": "stdio",
      "command": "${CURSOR_PLUGIN_ROOT}/bin/context-ledger-mcp",
      "args": [
        "serve"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}",
      "env": {
        "CONTEXT_LEDGER_MCP_CLIENT_TOKEN": "${env:CONTEXT_LEDGER_MCP_TOKEN}"
      }
    }
  }
}
