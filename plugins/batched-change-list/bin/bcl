#!/usr/bin/env python3
"""Stage-oriented entrypoint for batched-change-list."""
import argparse, hashlib, json, os, re, shlex, shutil, subprocess, sys, threading, time, uuid, selectors
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlsplit

HERE = Path(__file__).resolve().parents[1]
SKILL = HERE / "skills/batched-change-list"
SCRIPTS = SKILL / "scripts"
MANAGE = SCRIPTS / "manage_findings.py"
sys.path.insert(0, str(SCRIPTS))
import live_state
import manage_findings
import render as lane_render
import tracker_lock
import workflow_definition
import check_introspect
import events as bcl_events
import verify_driver

def _process_rows():
    """Read only pid/parent/group/comm; never inspect process arguments or environment."""
    try:
        raw = subprocess.check_output(["ps", "-axo", "pid=,ppid=,pgid=,comm="], text=True, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError):
        return []
    rows = []
    for line in raw.splitlines():
        parts = line.strip().split(None, 3)
        if len(parts) == 4 and all(part.isdigit() for part in parts[:3]):
            rows.append((int(parts[0]), int(parts[1]), int(parts[2]), Path(parts[3]).name))
    return rows

def _group_pids(pgid):
    return {pid for pid, _, group, _ in _process_rows() if group == pgid}

def _session_files(pid, sessions):
    """Return open session jsonl files for a live Codex pid, using lsof only."""
    try:
        row = next((item for item in _process_rows() if item[0] == pid), None)
        if not row or row[3] != "codex":
            return []
        output = subprocess.check_output(["lsof", "-Fn", "-p", str(pid)], text=True, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError, StopIteration):
        return []
    root = sessions.resolve()
    found = set()
    for line in output.splitlines():
        if not line.startswith("n"):
            continue
        candidate = Path(line[1:])
        try:
            resolved = candidate.resolve()
            if resolved.is_relative_to(root) and resolved.name.endswith(".jsonl") and resolved.is_file():
                found.add(resolved)
        except (OSError, ValueError, KeyError):
            pass
    return sorted(found)

def _stamp_session(path, job_id):
    sidecar = Path(str(path) + ".bcl-job")
    try:
        existing = sidecar.read_text(encoding="utf-8").strip()
        return existing == job_id
    except FileNotFoundError:
        pass
    except OSError:
        return False
    try:
        fd = os.open(sidecar, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(job_id + "\n")
        return True
    except FileExistsError:
        try:
            return sidecar.read_text(encoding="utf-8").strip() == job_id
        except OSError:
            return False
    except OSError:
        return False

def _first_error_line(text, limit=240):
    if not text:
        return None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped:
            return stripped[:limit]
    return None


def _write_job_output(list_path, job_id, output_text):
    path = bcl_events.events_path(list_path, os.environ.get("BCL_STATE_DIR")).parent / "jobs" / f"{job_id}.log"
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.write_text(output_text or "", encoding="utf-8")
    return path


def _read_usage(path, job_id):
    """Accept only a verified sidecar or in-file job ID; sum Codex cumulative usage once."""
    try:
        try:
            stamped = Path(str(path) + ".bcl-job").read_text(encoding="utf-8").strip() == job_id
        except OSError:
            stamped = False
        if not stamped and job_id not in Path(path).read_text(encoding="utf-8", errors="replace"):
            return None
        counts = None
        with Path(path).open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try: row = json.loads(line)
                except ValueError: continue
                payload = row.get("payload", row)
                if payload.get("type") == "token_count":
                    info = payload.get("info", {})
                    counts = info.get("total_token_usage") or counts
        if not isinstance(counts, dict):
            return None
        cached = counts.get("cached_input_tokens", counts.get("cached_tokens", 0))
        return {"input": int(counts.get("input_tokens", 0)), "cached": int(cached or 0),
                "output": int(counts.get("output_tokens", 0)),
                "total": int(counts.get("total_tokens", 0))}
    except (OSError, ValueError, TypeError):
        return None


def _repo_head(cwd):
    try:
        return subprocess.check_output(["git", "-C", str(cwd), "rev-parse", "HEAD"],
                                       text=True, stderr=subprocess.DEVNULL).strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def _dirty_fingerprint(cwd):
    try:
        output = subprocess.check_output(["git", "-C", str(cwd), "status", "--porcelain"],
                                         text=True, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError):
        return None
    fingerprints = {}
    for line in output.splitlines():
        if not line.strip():
            continue
        rel = line[3:] if len(line) > 3 else line.strip()
        if " -> " in rel:
            rel = rel.split(" -> ", 1)[-1]
        full = Path(cwd) / rel
        try:
            digest = hashlib.sha256(full.read_bytes()).hexdigest() if full.is_file() else "missing"
        except OSError:
            digest = "unreadable"
        fingerprints[rel] = (line[:2], digest)
    return fingerprints


def _named_worktree(groups):
    return any(isinstance(group, dict) and str(group.get("worktree") or "").strip() for group in groups or [])


def _last_verdict_block(text):
    lines = text.splitlines()
    starts = [i for i, line in enumerate(lines) if line.strip() in {"VERDICT: PASS", "VERDICT: CHANGES"}]
    if not starts:
        return None
    return "\n".join(lines[starts[-1]:]).strip() + "\n"

def _provider(url):
    return "gh" if (urlsplit(url).hostname or "").lower() == "github.com" else "origin"

def _ensure_viewer(parser, key, record, live, plugin_version, stage):
    try:
        return live_state.ensure_viewer(key, record, live, plugin_version, reject_unverifiable_pid=stage == "plan")
    except live_state.ViewerPIDProbeError as error:
        if stage != "plan":
            raise
        print(f"bcl: viewer PID probe failed: {error}", file=sys.stderr)
        raise SystemExit(1)
    except OSError as error:
        if stage != "plan":
            raise
        parser.error(str(error))

def _verification_failure_reason(command, observed):
    return f"Checked: verification command\nExpected: command exits 0\nObserved: {observed}"

def _pull_request_data(provider, url, repo):
    executable = shutil.which(provider)
    if not executable:
        return None, f"{provider} CLI is unavailable"
    fields = ("mergeCommit,mergedAt,headRefName,state",) if provider == "gh" else (
        "mergeCommit,mergedAt,headRefName,status", "mergeCommit,mergedAt,head,status",
        "merge_commit,merged_at,head_branch,status")
    for selected in fields:
        command = [executable, "pr", "view", url]
        if repo and not repo.startswith("local/"):
            command.extend(["--repo", repo])
        command.extend(["--json", selected])
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode:
            continue
        try:
            data = json.loads(result.stdout)
            if isinstance(data, dict) and isinstance(data.get("pullRequest"), dict):
                data = data["pullRequest"]
            if not isinstance(data, dict):
                continue
            return data, None
        except json.JSONDecodeError:
            continue
    return None, f"{provider} could not return merge metadata"

def _value(data, *keys):
    for key in keys:
        value = data.get(key)
        if value is not None:
            return value
    return None

def _merge_commit(value):
    if isinstance(value, dict):
        value = _value(value, "oid", "sha", "hash")
    return value if isinstance(value, str) else None

def _branch_name(value):
    if isinstance(value, dict):
        value = _value(value, "ref", "name", "branch")
    return value.strip() if isinstance(value, str) and value.strip() else None

def _utc_now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")

def _job_write(record, live, report, base, operations):
    command = [sys.executable, str(MANAGE), "batch", str(live), "-", "--render", str(report), "--base", str(base)]
    result = subprocess.run(command, input=json.dumps(operations), text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr or result.stdout)
    for attempt in range(3):
        try:
            live_state.snapshot(record, live)
            return
        except RuntimeError as error:
            if "live tracker changed during snapshot; retry" not in str(error) or attempt == 2:
                raise
            time.sleep(0.05 * (attempt + 1))

def _job_write_retry(record, live, report, base, operations):
    for attempt in range(3):
        try:
            return _job_write(record, live, report, base, operations)
        except RuntimeError as error:
            if "live tracker changed during snapshot; retry" in str(error) or attempt == 2:
                raise
            time.sleep(0.05 * (attempt + 1))
        except Exception:
            if attempt == 2:
                raise
            time.sleep(0.05 * (attempt + 1))

REVIEWER_FALLBACK_MODELS = ("gpt-6.2-astra",)
GROK_BOT_REVIEW = "Grok Bot subagent review (Astra 6.2 and Terra 6.1 unavailable)"


def _job_operations(phase, ids, cycle, round_number, job, action, timestamp, exit_code=None, reply=None,
                    load_override=None, fault_kind=None, substitution=None):
    operation = {"action": action, "phase": phase, "ids": ids, "cycle": cycle, "round": round_number,
                 "job_id": job["id"], "timestamp": timestamp, "plan_sha256": job["plan_sha256"]}
    if action == "start-job":
        operation["job"] = job
        if load_override:
            operation["load_override"] = load_override
    elif action == "attach-job":
        operation["pid"] = job["pid"]
    elif action == "finish-job":
        operation["exit_code"] = exit_code
        operation["reply"] = reply
        if fault_kind:
            operation["fault_kind"] = fault_kind
        if substitution:
            operation["substitution"] = substitution
        if job.get("first_error_line"):
            operation["first_error_line"] = job["first_error_line"]
        if job.get("output_path"):
            operation["output_path"] = job["output_path"]
        if "tokens_source" in job:
            operation["tokens_source"] = job.get("tokens_source")
        if "tokens" in job:
            operation["tokens"] = job.get("tokens")
        if job.get("wall_time_s") is not None:
            operation["wall_time_s"] = job["wall_time_s"]
        if job.get("session"):
            operation["session"] = job["session"]
        if job.get("gap"):
            operation["gap"] = job["gap"]
        if job.get("model"):
            operation["model"] = job["model"]
    elif action == "report-step":
        operation["step"] = job.get("step")
        if job.get("result"):
            operation["result"] = job["result"]
        if job.get("commit"):
            operation["commit"] = job["commit"]
    return [operation]

def _run_job(record, live, report, base, groups, phase, ids, command_args, result_file=None, model=None, load_override=None):
    if not command_args:
        raise ValueError("job requires a command after --")
    current = json.loads(live.read_text())
    tracking = current.get("tracking", {})
    plan = tracking.get("plan", {})
    cycle, round_number = plan.get("cycle", 1), plan.get("round", 1)
    started_at = _utc_now()
    result_path = Path(result_file) if phase in workflow_definition.LANE["review_phases"] and result_file else None
    try:
        previous_result = result_path.stat() if result_path else None
    except OSError:
        previous_result = None
    job = {"id": uuid.uuid4().hex, "phase": phase, "started_at": started_at,
           "command": Path(command_args[0]).name, "heartbeat_at": started_at,
           "plan_sha256": manage_findings.plan_candidate_sha256(plan),
           "finding_ids": list(ids)}
    job["worktree"] = Path.cwd().name
    if model:
        job["model"] = model
    start_head = start_dirty = None
    if phase == "fix" and _named_worktree(groups):
        start_head = _repo_head(Path.cwd())
        start_dirty = _dirty_fingerprint(Path.cwd())
    event_context = {"group_id": groups[0]["id"], "round": round_number}
    if model is not None:
        event_context["model"] = model
    if job.get("model_version") is not None:
        event_context["model_version"] = job["model_version"]
    repo = Path.cwd()
    list_path = Path(live).resolve()
    bcl_events.job_event(list_path, job["id"], "start", state_dir=os.environ.get("BCL_STATE_DIR"),
                         **event_context, phase=phase, agent=Path(command_args[0]).name, repo=repo.name, started_at=started_at)
    try:
        _job_write_retry(record, live, report, base,
                         _job_operations(phase, ids, cycle, round_number, job, "start-job", started_at,
                                         load_override=load_override))
    except Exception as error:
        try:
            bcl_events.job_event(list_path, job["id"], "failed_start", state_dir=os.environ.get("BCL_STATE_DIR"),
                               **event_context, phase=phase, agent=Path(command_args[0]).name, error=str(error))
        except OSError:
            pass
        raise
    try:
        child_env = os.environ.copy()
        child_env.pop("BCL_ALLOW_LIVE_STATE", None)
        child_env["BCL_JOB_ID"] = job["id"]
        process = subprocess.Popen(command_args, env=child_env, start_new_session=True,
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as error:
        _job_write_retry(record, live, report, base,
                         _job_operations(phase, ids, cycle, round_number, job, "finish-job", _utc_now(), exit_code=127))
        print(f"bcl: job command could not start: {error}", file=sys.stderr)
        bcl_events.job_event(list_path, job["id"], "failed_start", state_dir=os.environ.get("BCL_STATE_DIR"),
                             **event_context, phase=phase, agent=Path(command_args[0]).name, error=str(error))
        return 127
    output = {"stdout": bytearray(), "stderr": bytearray()}
    output_chunks = []
    output_lock = threading.Lock()
    def copy_streams():
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ, ("stdout", sys.stdout))
                selector.register(process.stderr, selectors.EVENT_READ, ("stderr", sys.stderr))
                while selector.get_map():
                    for ready, _ in selector.select(timeout=1):
                        pipe = ready.fileobj
                        key, destination = ready.data
                        # A single selector reader observes both streams. os.read
                        # returns available bytes without BufferedReader fill waits.
                        chunk = os.read(pipe.fileno(), 65536)
                        if not chunk:
                            selector.unregister(pipe)
                            continue
                        with output_lock:
                            output[key].extend(chunk)
                            output_chunks.append(chunk)
                        try:
                            destination.buffer.write(chunk); destination.buffer.flush()
                        except (AttributeError, OSError, BrokenPipeError):
                            pass
        except (OSError, ValueError):
            pass
    copiers = [threading.Thread(target=copy_streams, daemon=True)]
    for thread in copiers: thread.start()
    pgid = process.pid
    sessions = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "sessions"
    stamped = None
    job["pid"] = process.pid
    try:
        _job_write_retry(record, live, report, base,
                         _job_operations(phase, ids, cycle, round_number, job, "attach-job", _utc_now()))
    except Exception:
        try: os.killpg(pgid, 15)
        except OSError: pass
        process.wait()
        raise
    wait_deadline = time.monotonic() + 3600
    last_heartbeat = time.monotonic()
    while time.monotonic() < wait_deadline:
        live_pids = _group_pids(pgid)
        for pid in sorted(live_pids):
            open_sessions = _session_files(pid, sessions)
            if len(open_sessions) == 1 and _stamp_session(open_sessions[0], job["id"]):
                stamped = open_sessions[0]
        if process.poll() is not None and not live_pids:
            break
        try:
            process.wait(timeout=1)
            if _group_pids(pgid):
                time.sleep(0.25)
            else:
                break
        except subprocess.TimeoutExpired:
            pass
        if time.monotonic() - last_heartbeat >= 60:
            last_heartbeat = time.monotonic()
            job["heartbeat_at"] = _utc_now()
            try:
                _job_write(record, live, report, base,
                           _job_operations(phase, ids, cycle, round_number, job, "heartbeat-job", job["heartbeat_at"]))
            except Exception as error:
                print(f"bcl: job heartbeat write failed; will retry: {error}", file=sys.stderr)
    try:
        code = process.wait(timeout=0.1)
    except subprocess.TimeoutExpired:
        code = 124
        try: os.killpg(pgid, 15)
        except OSError: pass
    for thread in copiers: thread.join(timeout=2)
    for pipe in (process.stdout, process.stderr):
        # A blocked copier owns the buffered reader lock; closing its pipe here
        # can wait forever when an escaped descendant still has the fd open.
        if not copiers[0].is_alive():
            try: pipe.close()
            except OSError: pass
    for thread in copiers: thread.join(timeout=0.1)
    finished_at = _utc_now()
    if phase == "fix" and _named_worktree(groups) and start_head is not None:
        end_head = _repo_head(Path.cwd())
        end_dirty = _dirty_fingerprint(Path.cwd())
        if end_head == start_head:
            if code == 0:
                code = 3
            job["first_error_line"] = job.get("first_error_line") or "fix job made no commit"
        elif end_dirty is not None and start_dirty is not None:
            def _snapshot_path(rel):
                rel = rel.replace("\\", "/")
                return rel.startswith("docs/triage/") or rel.endswith("-findings.json") or rel.endswith("-findings.html")
            leftover = [path for path, mark in end_dirty.items()
                        if start_dirty.get(path) != mark and not _snapshot_path(path)]
            if leftover and code == 0:
                code = 3
                job["first_error_line"] = "fix job left uncommitted changes"
    reply = None
    if phase in workflow_definition.LANE["review_phases"] and result_path:
        try:
            current_result = result_path.stat()
            if previous_result is None or (current_result.st_ino, current_result.st_size, current_result.st_mtime_ns) != (previous_result.st_ino, previous_result.st_size, previous_result.st_mtime_ns):
                candidate = _last_verdict_block(result_path.read_text(encoding="utf-8"))
                if candidate is not None and manage_findings.parse_review_reply(candidate)[0] is not None:
                    reply = candidate
        except (OSError, UnicodeError):
            pass
    if phase in workflow_definition.LANE["review_phases"] and reply is None:
        reply = _last_verdict_block(b"".join(output_chunks).decode("utf-8", errors="replace"))
    finish_fault_kind = None
    finish_substitution = None
    output_text = b"".join(output_chunks).decode("utf-8", errors="replace")
    if (phase in workflow_definition.LANE["review_phases"] and reply is None
            and manage_findings.reviewer_model_rejected(output_text)):
        for fallback_model in REVIEWER_FALLBACK_MODELS:
            retry_env = os.environ.copy()
            retry_env.pop("BCL_ALLOW_LIVE_STATE", None)
            retry_env["BCL_JOB_ID"] = job["id"]
            retry_env["BCL_REVIEWER_MODEL"] = fallback_model
            retry_env["BCL_REVIEWER_FALLBACK"] = fallback_model
            try:
                retry = subprocess.Popen(command_args, env=retry_env, start_new_session=True,
                                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            except OSError:
                break
            retry_chunks = []
            def copy_retry():
                try:
                    with selectors.DefaultSelector() as selector:
                        selector.register(retry.stdout, selectors.EVENT_READ, ("stdout", sys.stdout))
                        selector.register(retry.stderr, selectors.EVENT_READ, ("stderr", sys.stderr))
                        while selector.get_map():
                            for ready, _ in selector.select(timeout=1):
                                pipe = ready.fileobj
                                key, destination = ready.data
                                chunk = os.read(pipe.fileno(), 65536)
                                if not chunk:
                                    selector.unregister(pipe)
                                    continue
                                retry_chunks.append(chunk)
                                try:
                                    destination.buffer.write(chunk); destination.buffer.flush()
                                except (AttributeError, OSError, BrokenPipeError):
                                    pass
                except (OSError, ValueError):
                    pass
            copier = threading.Thread(target=copy_retry, daemon=True)
            copier.start()
            try:
                code = retry.wait(timeout=3600)
            except subprocess.TimeoutExpired:
                code = 124
                try: os.killpg(retry.pid, 15)
                except OSError: pass
            copier.join(timeout=2)
            retry_text = b"".join(retry_chunks).decode("utf-8", errors="replace")
            output_chunks.extend(retry_chunks)
            output_text = output_text + retry_text
            if result_path:
                try:
                    current_result = result_path.stat()
                    if previous_result is None or (current_result.st_ino, current_result.st_size, current_result.st_mtime_ns) != (previous_result.st_ino, previous_result.st_size, previous_result.st_mtime_ns):
                        candidate = _last_verdict_block(result_path.read_text(encoding="utf-8"))
                        if candidate is not None and manage_findings.parse_review_reply(candidate)[0] is not None:
                            reply = candidate
                except (OSError, UnicodeError):
                    pass
            if reply is None:
                reply = _last_verdict_block(retry_text)
            if reply is not None:
                job["model"] = fallback_model
                finish_substitution = fallback_model
                break
            if not manage_findings.reviewer_model_rejected(retry_text):
                break
        if reply is None and manage_findings.reviewer_model_rejected(output_text):
            finish_fault_kind = "model_rejected"
            finish_substitution = GROK_BOT_REVIEW
            job["model"] = GROK_BOT_REVIEW
            # A later review job can record a Grok Bot verdict without a no-op fix.
    usage_path = stamped
    usage_source = "stamp" if stamped else "none"
    if usage_path is None:
        candidates = []
        try:
            for candidate in sessions.rglob("*.jsonl"):
                try:
                    if job["id"] in candidate.read_text(encoding="utf-8", errors="replace"):
                        candidates.append(candidate)
                except OSError:
                    continue
        except OSError:
            pass
        if len(candidates) == 1:
            usage_path, usage_source = candidates[0], "inline"
    usage = _read_usage(usage_path, job["id"]) if usage_path else None
    if usage is None:
        usage_source = "none"
    implementer = next(((group.get("codex") or {}).get("implementer_session")
                        for group in groups if isinstance(group, dict)
                        and (group.get("codex") or {}).get("implementer_session")), None)
    model = job.get("model") or event_context.get("model")
    gap = None if model else "no model recorded"
    wall_time_s = None
    started = job.get("started_at")
    if started and finished_at:
        try:
            start = datetime.fromisoformat(started.replace("Z", "+00:00"))
            end = datetime.fromisoformat(finished_at.replace("Z", "+00:00"))
            wall_time_s = max(0, int((end - start).total_seconds()))
        except ValueError:
            pass
    job["tokens_source"] = usage_source
    job["tokens"] = usage
    if wall_time_s is not None:
        job["wall_time_s"] = wall_time_s
    if usage_path is not None:
        job["session"] = usage_path.name
    elif implementer:
        job["session"] = implementer
    if gap:
        job["gap"] = gap
    if model:
        job["model"] = model
    try:
        if code != 0 or (output_text and output_text.strip()):
            try:
                log_path = _write_job_output(list_path, job["id"], output_text)
                job["output_path"] = str(log_path)
            except OSError:
                log_path = None
            if code != 0:
                job["first_error_line"] = job.get("first_error_line") or _first_error_line(output_text) or f"exited {code}"
        _job_write_retry(record, live, report, base,
                         _job_operations(phase, ids, cycle, round_number, job, "finish-job", finished_at,
                                         exit_code=code, reply=reply, fault_kind=finish_fault_kind,
                                         substitution=finish_substitution))
    except Exception as error:
        raise RuntimeError(f"child exited with code {code}; final tracker write failed: {error}") from error
    finished = json.loads(live.read_text())
    final = next(group for group in finished["tracking"]["plan"]["groups"] if group["id"] == groups[0]["id"])
    result_status = final.get("codex", {}).get("job", {}).get("finished_phase_status")
    event = {**event_context, "phase": phase, "agent": Path(command_args[0]).name, "repo": repo.name,
             "exit_code": code, "finished_at": finished_at, "tokens_source": usage_source,
             "tokens": usage, "session": job.get("session"),
             "model": model, "gap": gap,
             "first_error_line": job.get("first_error_line"),
             "output_path": job.get("output_path")}
    if wall_time_s is not None:
        event["wall_time_s"] = wall_time_s
    bcl_events.job_event(list_path, job["id"], "finish", state_dir=os.environ.get("BCL_STATE_DIR"), **event)
    return (code if code else 0 if result_status == "passed" else 1) if code >= 0 else 128 - code

def _install_tree_digest(root):
    digest = hashlib.sha256()
    count = 0
    for path in sorted(root.rglob("*")):
        if not path.is_file() or ".git" in path.parts or "__pycache__" in path.parts or path.suffix == ".pyc" or path.name == ".DS_Store":
            continue
        digest.update(path.relative_to(root).as_posix().encode())
        digest.update(b"\0")
        with path.open("rb") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
        digest.update(b"\0")
        count += 1
    return digest.hexdigest(), count

def install_local():
    with (HERE / "plugin.json").open() as manifest:
        version = json.load(manifest)["version"]
    revision = subprocess.check_output(["git", "-C", str(HERE), "rev-parse", "HEAD"], text=True).strip()
    # Only plugin-tree changes block install. The list's own snapshot and page live
    # outside this directory and are rewritten on every stage.
    dirty = subprocess.check_output(
        ["git", "-C", str(HERE), "status", "--porcelain", "--untracked-files=all", "--", "."],
        text=True,
    )
    if dirty:
        raise ValueError("plugin checkout has local changes; install from the merged HEAD")
    plugin_sha, _ = _install_tree_digest(HERE)
    skill_source = HERE / "skills/batched-change-list"
    skill_sha, _ = _install_tree_digest(skill_source)
    home = Path.home()
    destinations = [
        (HERE, home / ".agents/plugins/batched-change-list", plugin_sha),
        (skill_source, home / ".agents/skills/batched-change-list", skill_sha),
        *((HERE, home / f".{client}/plugins/cache/ingpoc-agent-plugins/batched-change-list/{ref}", plugin_sha)
          for client in ("cursor", "codex") for ref in (version, revision)),
    ]
    print(f"bcl install-local: revision {revision}")
    for source, destination, source_sha in destinations:
        if destination.is_symlink():
            destination.unlink()
        elif destination.exists():
            shutil.rmtree(destination)
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(source, destination, ignore=shutil.ignore_patterns(".git", "__pycache__", "*.pyc", ".DS_Store"))
        installed_sha, count = _install_tree_digest(destination)
        if installed_sha != source_sha:
            raise SystemExit(f"bcl install-local: sha256 mismatch at {destination}")
        print(f"  {destination} ({count} files, sha256 {installed_sha})")

def _plain_command(command):
    lexer = shlex.shlex(command, posix=True, punctuation_chars="|&;<>")
    lexer.whitespace_split = True
    lexer.commenters = ""
    words = list(lexer)
    if (not words or "\n" in command or "\r" in command
            or any(word and set(word) <= set("|&;<>") for word in words)
            or Path(words[0]).name in {"sh", "bash", "zsh", "ksh", "dash", "fish", "env"}
            or Path(words[0]).name in {"echo", "printf", "true", ":"}):
        raise ValueError("command must name one executable check without shell operators or wrappers")
    executable = (str(Path(words[0]).expanduser()) if "/" in words[0] else shutil.which(words[0]))
    if not executable or not os.access(executable, os.X_OK):
        raise ValueError(f"command is not executable: {words[0]}")
    words[0] = executable
    return words

def _require_machine_load(parser, args):
    """BCL-99: check the machine's load before a job or verify; a loaded machine fails checks for reasons outside the change."""
    try:
        limit = float(os.environ.get("BCL_MAX_LOAD") or (os.cpu_count() or 4))
        load = os.getloadavg()[0]
    except (OSError, ValueError, AttributeError):
        return None
    if load > limit:
        if not args.force:
            parser.error(f"machine load {load:.2f} is above {limit:g}; wait for it to settle (or pass --force with --reason)")
        try:
            args.reason = manage_findings.require_override_reason(args.reason, "machine-load")
        except ValueError as error:
            parser.error(str(error))
        return args.reason
    return None

def _merged_details(args, tracking, repo):
    pr = tracking.get("pull_request", {})
    url = pr.get("url") if isinstance(pr, dict) else None
    if not isinstance(url, str) or not url:
        raise ValueError("bcl merged requires tracking.pull_request.url")
    provider = _provider(url)
    data, problem = (None, None)
    if not (args.merge_commit and args.merged_at and args.base_branch):
        data, problem = _pull_request_data(provider, url, repo)
    if data:
        state = str(_value(data, "state", "status") or "").lower()
        api_time = _value(data, "mergedAt", "merged_at")
        api_commit = _merge_commit(_value(data, "mergeCommit", "merge_commit"))
        if state in ("open", "draft") or (state in ("closed", "closed_unmerged") and not api_time):
            raise ValueError("pull request is not merged; bcl merged only records an already merged pull request")
    else:
        api_time = api_commit = None
    commit = args.merge_commit or api_commit
    merged_at = args.merged_at or api_time
    branch = args.base_branch or (_branch_name(_value(data, "headRefName", "head_branch", "head")) if data else None)
    if not commit or not merged_at:
        detail = problem or "merge metadata was not returned"
        raise ValueError(f"cannot confirm merge metadata ({detail}); pass --merge-commit SHA and --merged-at ISO-8601")
    manage_findings.validate_merged_record({"commit_sha":commit, "merged_at":merged_at,
                                            "stacked_prs":{"status":"pending"}})
    return provider, url, commit, merged_at, branch

def _retarget_stacked(provider, repo, branch, pull_number):
    target = "main"
    todo = f"list open PRs based on {branch or '<unknown branch>'} and retarget them to {target}"
    if not branch:
        return {"status":"pending", "base_branch":None, "target_branch":target,
                "retargeted_prs":[], "pending_prs":[], "todo":todo}
    if branch == target:
        return {"status":"complete", "base_branch":branch, "target_branch":target,
                "retargeted_prs":[], "pending_prs":[], "todo":""}
    executable = shutil.which(provider)
    if not executable or not repo or repo.startswith("local/"):
        return {"status":"pending", "base_branch":branch, "target_branch":target,
                "retargeted_prs":[], "pending_prs":[], "todo":todo}
    if provider == "gh":
        command = [executable, "pr", "list", "--repo", repo, "--state", "open", "--base", branch,
                   "--limit", "1000", "--json", "number"]
    else:
        command = [executable, "pr", "list", "--repo", repo, "--state", "open", "--base", branch,
                   "--limit", "1000", "--json", "number"]
    result = subprocess.run(command, capture_output=True, text=True)
    try:
        prs = json.loads(result.stdout) if result.returncode == 0 else None
    except json.JSONDecodeError:
        prs = None
    if not isinstance(prs, list):
        return {"status":"pending", "base_branch":branch, "target_branch":target,
                "retargeted_prs":[], "pending_prs":[], "todo":todo}
    retargeted, pending = [], []
    for pr in prs:
        number = pr.get("number") if isinstance(pr, dict) else None
        if str(number) == str(pull_number):
            continue
        if not isinstance(number, (int, str)) or not str(number).isdigit():
            pending.append(str(number or "unknown")); continue
        command = [executable, "pr", "edit", str(number)]
        command.extend(["--repo", repo, "--base", target])
        edited = subprocess.run(command, capture_output=True, text=True)
        (retargeted if edited.returncode == 0 else pending).append(int(number))
    status = "complete" if not pending else "partial" if retargeted else "pending"
    return {"status":status, "base_branch":branch, "target_branch":target,
            "retargeted_prs":retargeted, "pending_prs":pending, "todo":todo if pending else ""}

def _new_pr_url(old_url, number, explicit):
    if explicit:
        url = explicit
    else:
        url, count = re.subn(r"(/pull/)\d+(?=$|[?#])", rf"\g<1>{number}", old_url, count=1)
        if not count:
            raise ValueError("cannot derive the new PR URL; pass --new-url")
    match = re.search(r"/pull/(\d+)(?=$|[?#])", url)
    if not match or int(match.group(1)) != number:
        raise ValueError("--new-url must contain the --new-pr number in its /pull/N path")
    return url


def _manage_in_process(argv, stdin_text=None):
    """Run manage_findings in this process so allow_live_writes still applies."""
    import contextlib, io
    stdout, stderr = io.StringIO(), io.StringIO()
    stdin = io.StringIO(stdin_text or "")
    previous = sys.stdin
    try:
        sys.stdin = stdin
        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
            try:
                code = manage_findings.main(argv)
            except SystemExit as error:
                code = 0 if error.code is None else (error.code if isinstance(error.code, int) else 1)
    finally:
        sys.stdin = previous
    return argparse.Namespace(returncode=code or 0, stdout=stdout.getvalue(), stderr=stderr.getvalue())

def _git(cwd, *args):
    return subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)

def _refresh_worktrees(args, tracking, parser):
    """BCL-158: give each unverified lane of this round a fresh worktree at the list branch head, replaying its commits."""
    repo = (args.repo or Path.cwd()).resolve()
    head = _git(repo, "rev-parse", "HEAD")
    if head.returncode:
        parser.error(f"refresh-worktrees: {repo} is not a git checkout; pass --repo LIST_WORKTREE")
    head = head.stdout.strip()
    round_number = lane_render.rollover_round(tracking)
    groups = lane_render.plan_groups_for_round(tracking.get("plan"), round_number)
    operations = []
    for group in groups:
        name = group.get("worktree")
        if not isinstance(name, str) or not name or lane_render.plan_status(group) == "verified":
            continue
        if args.ids and not set(args.ids) & set(group.get("finding_ids", [])):
            continue
        fresh = _fresh_worktree_name(name, round_number)
        old, new = repo.parent / name, repo.parent / fresh
        if fresh == name or new.exists():
            continue
        old_head = _git(old, "rev-parse", "HEAD").stdout.strip() if old.is_dir() else ""
        commits = _git(repo, "rev-list", "--reverse", "--no-merges", f"{head}..{old_head}").stdout.split() if old_head else []
        if args.dry_run:
            replay = ", ".join(commits) or "none"
            print(f"{group['id']}: planned worktree {new}; base {head}; commits to replay: {replay}")
            continue
        made = _git(repo, "worktree", "add", "-q", "-b", f"bcl/{fresh}", str(new), head)
        if made.returncode:
            print(f"refresh-worktrees: cannot create {new}: {made.stderr.strip()}", file=sys.stderr)
            raise SystemExit(1)
        for commit in commits:
            if _git(new, "cherry-pick", "--allow-empty", commit).returncode:
                files = _git(new, "diff", "--name-only", "--diff-filter=U").stdout.split()
                _git(new, "cherry-pick", "--abort")
                _git(repo, "worktree", "remove", "--force", str(new))
                _git(repo, "branch", "-D", f"bcl/{fresh}")
                print(f"refresh-worktrees: lane {group['id']} commit {commit[:8]} conflicts with the list branch in "
                      f"{', '.join(files) or 'unknown files'}; resolve in {old} and rerun", file=sys.stderr)
                raise SystemExit(1)
        if not args.no_record:
            operations.append({"action": "update-plan-group", "id": group["id"], "patch": {"worktree": fresh}})
        print(f"{group['id']}: fresh worktree {new} at {head[:8]} with {len(commits)} commits replayed")
    return operations

def _fresh_worktree_name(name, round_number):
    marker = re.search(r"-r[0-9]+(?=-|$)", name)
    return re.sub(r"-r[0-9]+(?=-|$)", f"-r{round_number}", name, count=1) if marker else f"{name}-r{round_number}"

KNOWN_STAGES = frozenset((
    "adopt",
    "archive-history",
    "cleanup",
    "correct-round",
    "fix",
    "fix-order",
    "install",
    "install-hooks",
    "install-local",
    "introspect",
    "job",
    "merge",
    "merged",
    "pause",
    "plan",
    "refresh-worktrees",
    "release-check",
    "report",
    "resort-failures",
    "resume",
    "report-step",
    "review",
    "rollover",
    "snapshot",
    "start",
    "status",
    "stop-verify",
    "stop-viewer",
    "unblock",
    "verify",
))


def main():
    live_state.allow_live_writes()
    parser = argparse.ArgumentParser()
    parser.add_argument("--data", type=Path); parser.add_argument("--render", type=Path)
    parser.add_argument("--progress", type=Path); parser.add_argument("--now")
    parser.add_argument("--ids", action="append", default=[]); parser.add_argument("--plan", type=Path)
    parser.add_argument("--into", help="merge: the finding that absorbs the others")
    parser.add_argument("--result"); parser.add_argument("--issues", type=Path); parser.add_argument("--sections", type=Path); parser.add_argument("--draft", type=Path)
    parser.add_argument("--phase", choices=workflow_definition.LANE["job_phases"])
    parser.add_argument("--model", help="job, install or verify: who runs this step, shown in the lane model column")
    parser.add_argument("--round", type=int, help="correct-round: the real round number")
    parser.add_argument("--by", help="fix-order: who set the order")
    parser.add_argument("--reason", help="why an override, fix order, verify rerun, cleanup failure, stopped run, resort-failures apply, or pause is recorded")
    parser.add_argument("--tool-fault", action="append", default=[], help="unblock or resort-failures --apply: failure attempt ID recorded as a tool fault; repeat for each attempt")
    parser.add_argument("--repo", type=Path); parser.add_argument("--then", dest="then_command")
    parser.add_argument("--dry-run", action="store_true"); parser.add_argument("--no-record", action="store_true")
    parser.add_argument("--shared", action="store_true")
    parser.add_argument("--new-pr", type=int); parser.add_argument("--new-url"); parser.add_argument("--worktree")
    parser.add_argument("--merge-commit"); parser.add_argument("--merged-at"); parser.add_argument("--base-branch")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--apply", action="store_true", help="resort-failures: apply the listed tool-fault uncounts")
    parser.add_argument("--run-id"); parser.add_argument("--outcome", choices=("passed", "failed", "not_run"))
    parser.add_argument("--through-cycle", type=int)
    parser.add_argument("stage")
    argv = sys.argv[1:]
    job_command = []
    if "--" in argv:
        marker = argv.index("--")
        argv, job_command = argv[:marker], argv[marker + 1:]
    args, unknown = parser.parse_known_args(argv)
    command_args = job_command if args.stage == "job" else unknown
    if args.stage not in KNOWN_STAGES:
        parser.error("unknown stage")
    if args.stage == "install-local":
        try: install_local()
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            print(f"bcl install-local: {error}", file=sys.stderr); raise SystemExit(1)
        return
    if args.stage == "adopt" and not args.data and command_args: args.data = Path(command_args.pop(0))
    if args.stage == "install-hooks":
        root = Path(subprocess.check_output(["git", "-C", str(args.repo or Path.cwd()), "rev-parse", "--show-toplevel"], text=True).strip())
        hooks = root / ".githooks"; hooks.mkdir(exist_ok=True)
        subprocess.run(["git", "-C", str(root), "config", "core.hooksPath", ".githooks"], check=True)
        tool = HERE / "bin/bcl-hook"
        for name in ("pre-commit", "pre-push"):
            path = hooks / name
            if path.exists() and "bcl-hook" in path.read_text(): continue
            old = ""
            if path.exists():
                backup = hooks / f"{name}.bcl-original"
                if not backup.exists(): backup.write_text(path.read_text()); backup.chmod(0o755)
                old = f'"$(dirname "$0")/{backup.name}" "$@" || exit $?\n'
            path.write_text(f'#!/bin/sh\n{old}exec "{tool}" "{root}"\n'); path.chmod(0o755)
        return
    if not args.data: parser.error("--data is required")
    source = args.data.resolve()
    try: key, record, live = live_state.locate(source, adopt=args.stage == "adopt", render_path=args.render if args.stage == "adopt" else None)
    except ValueError as error: parser.error(str(error))
    plugin_version = json.loads((HERE / "plugin.json").read_text())["version"]
    if args.stage == "adopt" and record:
        import render
        report, base = live_state.report_paths(record, live)
        report.write_text(render.render(json.loads(live.read_text()), base))
    drafting_introspect = args.stage == "introspect" and args.draft is not None
    if (record and record.get("home") and not record.get("rollover_pending")
            and args.stage not in ("stop-viewer", "merged", "snapshot", "release-check") and not drafting_introspect):
        _ensure_viewer(parser, key, record, live, plugin_version, args.stage)
    if args.stage == "adopt":
        if not record: parser.error("could not register tracker")
        print(live); return
    if not record:
        if args.stage in ("status", "release-check", "resort-failures"):
            print(json.dumps({"adopted": False, "message": "Run bcl adopt <tracker-in-repo> first."}))
            if args.stage == "release-check":
                sys.exit(2)  # an unknown lane state is never a clear release
            return
        parser.error("tracker is not adopted; run bcl adopt <tracker-in-repo>")
    if source != live and source.read_bytes() != live.read_bytes():
        parser.error(f"in-repo tracker differs from live state; live file: {live}")
    data = json.loads(live.read_text())
    tracking = data.get("tracking", {}); stages = tracking.get("stages_reached", [])
    if args.draft:
        if args.stage != "introspect" or args.sections:
            parser.error("--draft is only valid for introspect and cannot be combined with --sections")
        trackers = (source.resolve(), live.resolve())
        if args.draft.resolve() in trackers or (args.draft.exists() and any(args.draft.samefile(path) for path in trackers)):
            parser.error("Introspect draft path must differ from the input and live trackers")
        try:
            payload = check_introspect.draft_introspect(tracking)
            args.draft.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        except (OSError, ValueError) as error:
            parser.error(str(error))
        print(args.draft)
        return
    if args.stage == "snapshot":
        try:
            print(live_state.snapshot(record, live, pending_only=True))
        except tracker_lock.LockBusyError:
            print("bcl: snapshot refused; home-worktree or tracker lock is busy", file=sys.stderr)
            raise SystemExit(2)
        except RuntimeError as error:
            if "active codex.job" in str(error):
                print(f"bcl: snapshot refused; {error}", file=sys.stderr)
                raise SystemExit(2)
            raise
        return
    begins_collect = args.stage == "start" and ("collect" not in stages or record.get("rollover_pending"))
    stamp = args.now or datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
    if args.stage in ("cleanup", "archive-history"):
        if args.stage == "cleanup":
            if not args.run_id or not args.outcome:
                parser.error("cleanup requires --run-id ID and --outcome passed|failed|not_run")
            if args.outcome == "failed" and not args.reason:
                parser.error("failed cleanup requires --reason")
            operation = {"action": "record-cleanup", "run_id": args.run_id, "outcome": args.outcome,
                         "reason": args.reason or "", "timestamp": stamp}
        else:
            operation = {"action": "archive-history", "through_cycle": lane_render.rollover_cycle(tracking) - 1 if args.through_cycle is None else args.through_cycle}
        report, base = live_state.report_paths(record, live)
        command = [sys.executable, str(MANAGE), "batch", str(live), "-", "--render", str(report), "--base", str(base)]
        result = subprocess.run(command, input=json.dumps([operation]), text=True, capture_output=True)
        if result.returncode:
            sys.stderr.write(result.stderr or result.stdout)
            raise SystemExit(result.returncode)
        live_state.snapshot(record, live)
        return
    if args.stage in ("pause", "resume"):
        if args.stage == "pause":
            try:
                reason = manage_findings.require_override_reason(args.reason, "pause")
            except ValueError as error:
                parser.error(str(error))
            operation = {"action": "pause", "reason": reason, "timestamp": stamp}
        else:
            operation = {"action": "resume", "timestamp": stamp}
        report, base = live_state.report_paths(record, live)
        command = [sys.executable, str(MANAGE), "batch", str(live), "-", "--render", str(report), "--base", str(base)]
        result = subprocess.run(command, input=json.dumps([operation]), text=True, capture_output=True)
        if result.returncode:
            sys.stderr.write(result.stderr or result.stdout)
            raise SystemExit(result.returncode)
        print(result.stdout, end="")
        try:
            payload = json.loads(result.stdout)
        except json.JSONDecodeError:
            payload = {}
        if payload.get("changed", True):
            live_state.snapshot(record, live)
        return
    if args.stage == "status":
        recorded_stage = tracking.get("workflow", {}).get("stage")
        plan = tracking.get("plan")
        groups = lane_render.plan_groups_for_round(plan, lane_render.rollover_round(tracking))
        current_stage = lane_render.current_workflow_stage(recorded_stage, groups)
        fixed, threshold, report_met = workflow_definition.run_check("gate", data)
        verified_fixed, verified_threshold, verified_met = manage_findings.check_gate_count.verified_gate_count(data)
        _, rollover_threshold, rollover_met = manage_findings.check_gate_count.rollover_gate_count(data)
        print(json.dumps({"adopted": True, "live": str(live), "stage": current_stage, "recorded_stage": recorded_stage, "cycle": tracking.get("cycle", 1), "report_gate": {"fixed": fixed, "threshold": threshold, "met": report_met}, "verified_gate": {"fixed": verified_fixed, "threshold": verified_threshold, "met": verified_met}, "rollover_gate": {"fixed": fixed, "threshold": rollover_threshold, "met": rollover_met}, "plan": [{"id": g.get("id"), "status": g.get("status"), "message": lane_render.lane_issue_status(g, lane_render.rollover_round(tracking), (tracking.get("workflow") or {}).get("paused")).get("copy")} for g in tracking.get("plan", {}).get("groups", [])]}, indent=2)); return
    if args.stage == "release-check":
        payload = manage_findings.release_check_payload(data, args.ids)
        print(json.dumps(payload, indent=2))
        raise SystemExit(0 if payload["clear"] else 2)
    if args.stage == "resort-failures":
        if args.apply:
            try:
                reason = manage_findings.require_override_reason(args.reason, "resort-failures")
                report, base = live_state.report_paths(record, live)
                _job_write(record, live, report, base, [{"action": "resort-failures", "apply": True,
                             "reason": reason, "tool_faults": list(args.tool_fault), "timestamp": _utc_now()}])
            except (OSError, RuntimeError, ValueError) as error:
                parser.error(str(error))
            print(json.dumps(manage_findings.resort_failures(json.loads(live.read_text()), {"apply": False}), indent=2))
            return
        if args.tool_fault:
            parser.error("resort-failures --tool-fault needs --apply and --reason")
        print(json.dumps(manage_findings.resort_failures(data, {"apply": False}), indent=2))
        return
    if record.get("rollover_pending") and (args.stage != "start" or not begins_collect):
        parser.error("run bcl start to begin Collect before using the new list")
    if manage_findings.pause_record(tracking) is not None and args.stage in ("job", "review", "install", "verify"):
        parser.error("round paused; run bcl resume")
    load_override = _require_machine_load(parser, args) if args.stage in ("job", "verify") else None
    if args.stage == "merge":
        if not args.into or not args.ids or not args.plan:
            parser.error("merge requires --into ID, --ids ID (repeat), and --plan FILE with title, summary, recommendation and done_when")
        fields = json.loads(args.plan.read_text())
        if not isinstance(fields, dict):
            parser.error("merge --plan must be a JSON object")
        operation = {"action": "merge", "into": args.into, "ids": list(args.ids),
                     "title": fields.get("title"), "summary": fields.get("summary"),
                     "recommendation": fields.get("recommendation"), "done_when": fields.get("done_when")}
        report, base = live_state.report_paths(record, live)
        try:
            _job_write(record, live, report, base, [operation])
        except (OSError, RuntimeError, ValueError) as error:
            parser.error(str(error))
        print(json.dumps({"merged_into": args.into, "absorbed": list(args.ids)}))
        return
    if args.stage == "report-step":
        job_id = os.environ.get("BCL_JOB_ID")
        if not job_id:
            parser.error("report-step must run inside a bcl job (BCL_JOB_ID)")
        if not command_args:
            parser.error("report-step requires a step after --")
        step, result, commit = command_args[0], (command_args[1] if len(command_args) > 1 else None), (
            command_args[2] if len(command_args) > 2 else None)
        groups = [group for group in tracking.get("plan", {}).get("groups", [])
                  if ((group.get("codex") or {}).get("job") or {}).get("id") == job_id
                  and "exit_code" not in ((group.get("codex") or {}).get("job") or {})]
        if not groups:
            parser.error("report-step is refused for a job that is not this lane's running job")
        job = groups[0]["codex"]["job"]
        ids = args.ids or list(groups[0].get("finding_ids") or [])
        if args.ids:
            covered = {identifier for group in groups for identifier in group.get("finding_ids", [])}
            if not set(args.ids).issubset(covered):
                parser.error("report-step IDs must belong to the running job's lane")
        report, base = live_state.report_paths(record, live)
        payload = {"id": job_id, "plan_sha256": job["plan_sha256"], "step": step,
                   "result": result, "commit": commit}
        try:
            _job_write(record, live, report, base,
                       _job_operations(job.get("phase"), ids, job.get("cycle"), job.get("round"),
                                       payload, "report-step", _utc_now()))
        except (OSError, RuntimeError, ValueError) as error:
            parser.error(str(error))
        return
    if args.stage == "job":
        if args.phase not in workflow_definition.LANE["job_phases"] or not args.ids or not command_args:
            parser.error("job requires --ids ID, --phase plan_review|fix|review|presuite, and -- <command>")
        if args.phase in workflow_definition.LANE["review_phases"] and not args.result:
            parser.error(f"{args.phase} job requires --result FILE for its reply")
        if len(args.ids) != len(set(args.ids)):
            parser.error("job IDs must be unique")
        groups = [group for group in tracking.get("plan", {}).get("groups", [])
                  if set(args.ids).intersection(group.get("finding_ids", []))]
        covered = {identifier for group in groups for identifier in group.get("finding_ids", [])}
        if not groups or not set(args.ids).issubset(covered):
            parser.error("job IDs must be covered by current plan groups")
        if args.phase == "fix":
            if any(group.get("status") in workflow_definition.LANE["groups"]["fix_refused"] for group in groups):
                parser.error("fix job cannot start a blocked, parked, or deferred lane; run bcl unblock --reason for blocked lanes")
        if args.phase in workflow_definition.LANE["groups"]["post_fix_job_phases"] and any(group.get("phase") != "review" or (group.get("codex") or {}).get("fix_status") != "passed" for group in groups):
            parser.error("review and presuite jobs require each lane to finish fix and enter review")
        elif args.phase == "review":
            try:
                workflow_definition.run_stage_check("review", tracking.get("plan"), args.ids)
            except ValueError as error:
                parser.error(str(error))
        report, base = live_state.report_paths(record, live)
        try:
            code = _run_job(record, live, report, base, groups, args.phase, args.ids, command_args, args.result,
                            (args.model or "").strip() or None, load_override)
        except (OSError, RuntimeError, ValueError) as error:
            parser.error(str(error))
        raise SystemExit(code)
    if args.stage == "unblock":
        if not args.ids:
            parser.error("unblock requires --ids ID (repeat for each finding)")
        try:
            reason = manage_findings.require_override_reason(args.reason, "unblock")
            report, base = live_state.report_paths(record, live)
            _job_write(record, live, report, base, [{"action": "unblock-lane", "ids": args.ids,
                         "reason": reason, "tool_faults": args.tool_fault, "timestamp": _utc_now()}])
        except (OSError, RuntimeError, ValueError) as error:
            parser.error(str(error))
        return
    if args.stage == "review":
        if not args.ids:
            parser.error("review requires --ids ID (repeat for each finding)")
        groups = [group for group in tracking.get("plan", {}).get("groups", [])
                  if set(args.ids).intersection(group.get("finding_ids", []))]
        covered = {identifier for group in groups for identifier in group.get("finding_ids", [])}
        if not groups or not set(args.ids).issubset(covered):
            parser.error("review IDs must be covered by current plan groups")
        for group in groups:
            codex = group.get("codex") if isinstance(group.get("codex"), dict) else {}
            if codex.get("fix_status") != "passed":
                parser.error(f"review cannot start: lane {group.get('id')} has not finished fix")
        try:
            workflow_definition.run_stage_check("review", tracking.get("plan"), args.ids)
        except ValueError as error:
            parser.error(str(error))
        operations = [{"action": "set-activity", "stage": "review", "ids": args.ids, "now": "Review started"}]
        for group in groups:
            if (group.get("codex") or {}).get("one_file"):
                operations.append({"action": "skip-review", "ids": sorted(set(args.ids).intersection(group.get("finding_ids", [])))})
        report, base = live_state.report_paths(record, live)
        command = [sys.executable, str(MANAGE), "batch", str(live), "-", "--render", str(report), "--base", str(base)]
        result = subprocess.run(command, input=json.dumps(operations), text=True, capture_output=True)
        if result.returncode:
            sys.stderr.write(result.stderr or result.stdout)
            raise SystemExit(result.returncode)
        live_state.snapshot(record, live)
        return
    if args.stage == "rollover":
        if not args.new_pr or args.new_pr < 1 or not args.worktree:
            parser.error("rollover requires --new-pr N and --worktree NAME")
        old_pr = tracking.get("pull_request", {})
        old_url = old_pr.get("url") if isinstance(old_pr, dict) else None
        if not isinstance(old_url, str): parser.error("rollover requires tracking.pull_request.url")
        try:
            new_url = _new_pr_url(old_url, args.new_pr, args.new_url)
        except ValueError as error:
            parser.error(str(error))
        operation = {"action":"rollover", "pull_request":{"label":f"PR #{args.new_pr}", "url":new_url},
                     "worktree":args.worktree}
        if args.force:
            operation["override_reason"] = args.reason
        if args.now: operation["now"] = args.now
        argv = ["batch", str(live), "-"]
        if args.force: argv.append("--force")
        result = _manage_in_process(argv, json.dumps([operation]))
        if result.returncode:
            sys.stderr.write(result.stderr or result.stdout)
            raise SystemExit(result.returncode)
        sys.stdout.write(result.stdout)
        return
    if args.stage == "merged":
        if args.force:
            try:
                args.reason = manage_findings.require_override_reason(args.reason, "merged")
            except ValueError as error:
                parser.error(str(error))
        url = tracking.get("pull_request", {}).get("url", "")
        repo = live_state.repo_id(record.get("home", ""), _provider(url)) if url else record.get("repo", "")
        try:
            provider, url, commit, merged_at, branch = _merged_details(args, tracking, repo)
        except ValueError as error:
            parser.error(str(error))
        match = re.search(r"/pull/(\d+)", url)
        stacked = _retarget_stacked(provider, repo, branch, match.group(1) if match else None)
        merged = {"commit_sha":commit, "merged_at":merged_at, "stacked_prs":stacked}
        report, base = live_state.report_paths(record, live)
        command = [sys.executable, str(MANAGE), "batch", str(live), "-", "--render", str(report), "--base", str(base)]
        operation = {"action":"set-stage", "stage":"merged", "merged":merged}
        if args.force:
            operation["override_reason"] = args.reason.strip()
            command.append("--force")
        result = subprocess.run(command, input=json.dumps([operation]), text=True, capture_output=True)
        if result.returncode: sys.stderr.write(result.stderr or result.stdout); raise SystemExit(result.returncode)
        live_state.snapshot(record, live)
        try: live_state.stop_viewer(key, record)
        except (OSError, RuntimeError, ValueError) as error: parser.error(str(error))
        if stacked["status"] != "complete":
            print(f"TODO: {stacked['todo']}", file=sys.stderr)
        print(f"Marked {tracking.get('pull_request', {}).get('label', 'pull request')} Merged / Done ({commit[:12]} at {merged_at})")
        return
    if args.stage == "stop-viewer":
        try: stopped = live_state.stop_viewer(key, record)
        except (OSError, RuntimeError, ValueError) as error: parser.error(str(error))
        print(json.dumps({"stopped": stopped}))
        return
    stamp = args.now or datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
    stage = args.stage
    expected_verify_plan = None
    expected_verify_plan_sha256 = None
    rerun_op = None
    if stage == "start": operations = [{"action":"set-activity","stage":"collect" if record.get("rollover_pending") else "present" if "collect" in stages else "collect","ids":args.ids,"now":"Started collection"}]
    elif stage == "plan":
        plan = json.loads(args.plan.read_text()) if args.plan else tracking.get("plan")
        if not plan: parser.error("plan requires --plan or an existing tracking.plan")
        operations = [{"action":"set-plan","plan":plan}]
        current_plan = tracking.get("plan")
        current_round = tracking.get("round")
        if current_round is None:
            current_round = current_plan.get("round", 1) if isinstance(current_plan, dict) else 1
        current_cycle = tracking.get("cycle", 1)
        same_current_plan = (
            isinstance(current_plan, dict)
            and type(current_cycle) is int and type(current_round) is int
            and current_plan.get("cycle", current_cycle) == current_cycle
            and type(current_plan.get("round", current_round)) is int
            and current_plan.get("round", current_round) == current_round
            and isinstance(plan, dict)
            and type(plan.get("round")) is int and plan["round"] == current_round
        )
        late_stage = tracking.get("workflow", {}).get("stage") in ("verify", "introspect", "gate")
        if args.ids and not (late_stage and same_current_plan):
            operations.append({"action":"set-activity","stage":"plan_fix","ids":args.ids,"now":"Plan recorded"})
    elif stage == "stop-verify":
        run = tracking.get("verification_run")
        if not isinstance(run, dict) or run.get("status") != "active":
            parser.error("stop-verify requires an active verification run")
        if not (args.reason or "").strip():
            parser.error('stop-verify requires --reason "why the run stops"; finished verdicts are kept')
        operations = [{"action": "stop-verification", "run_id": run["id"], "reason": args.reason}]
    elif stage == "refresh-worktrees":
        operations = _refresh_worktrees(args, tracking, parser)
        if not operations:
            print("no carried lane needs a fresh worktree"); return
    elif stage == "fix-order":
        if not args.ids or not args.reason:
            parser.error("fix-order requires --ids in order (repeat --ids) and --reason \"why this order\"")
        operations = [{"action":"set-fix-order", "ids":args.ids, "reason":args.reason, "by":args.by or os.environ.get("USER") or "unknown"}]
    elif stage == "correct-round":
        if args.round is None or not args.reason:
            parser.error("correct-round requires --round N and --reason \"why the counter is wrong\"")
        operations = [{"action":"correct-round", "round":args.round, "reason":args.reason}]
    elif stage == "verify" and args.shared:
        run = tracking.get("verification_run")
        if not isinstance(run, dict) or run.get("status") != "active":
            parser.error("shared verify requires an active installation verification run")
        if not args.then_command or command_args:
            parser.error("shared verify requires --then with one executable command")
        try:
            words = _plain_command(args.then_command)
        except ValueError as error:
            parser.error(str(error))
        operations = [{"action":"reserve-shared-check", "run_id":run["id"], "command":args.then_command}]
        if args.reason: operations[0]["reason"] = args.reason
    elif stage in ("fix", "install", "verify"):
        ids = args.ids or [x["id"] for x in data.get("findings", []) if x.get("status") == "in_progress"]
        if stage == "verify":
            shared = tracking.get("verification_run", {}).get("shared_check")
            if not args.shared and isinstance(shared, dict) and shared.get("state") != "passed":
                parser.error("lane verify requires the shared check to pass first; run bcl verify --shared --then CMD")
            groups = [g for g in tracking.get("plan", {}).get("groups", []) if set(ids).intersection(g.get("finding_ids", []))]
            covered = {identifier for group in groups for identifier in group.get("finding_ids", [])}
            if not groups or not set(ids).issubset(covered):
                parser.error("verify requires IDs covered by the current plan")
            failed_lanes = [g['id'] for g in groups if g.get('status') == 'failed']
            if args.reason and not failed_lanes:
                parser.error("--reason reruns a failed lane's check; none of these lanes failed")
            if failed_lanes and args.reason and not any(g.get('status') in workflow_definition.LANE["groups"]["verify_rerun_excluded"] for g in groups):
                # Preview only: the rerun is written in the same batch that starts verify, after
                # every check below and under the verification lock, so a refusal spends nothing.
                rerun_op = {"action":"rerun-verify", "ids":failed_lanes, "reason":args.reason}
                preview = json.loads(json.dumps(data))
                try:
                    manage_findings.rerun_verify(preview, rerun_op, stamp)
                except ValueError as error:
                    parser.error(str(error))
                groups = [g for g in preview.get("tracking", {}).get("plan", {}).get("groups", []) if set(ids).intersection(g.get("finding_ids", []))]
            if any(g.get('status') in workflow_definition.LANE["groups"]["verify_refused"] for g in groups):
                parser.error("verify cannot start a blocked, failed, or parked lane; rerun a failed lane's check once with --reason \"why\"")
            values = [g.get("verify", {}).get("command", "") for g in groups]
            if any(not isinstance(value, str) for value in values):
                parser.error("stored verify command must be text")
            commands = set(values)
            if len(commands) != 1 or not next(iter(commands), "").strip():
                parser.error("verify requires one stored command; verify groups with different commands separately")
            expected = next(iter(commands))
            try:
                words = _plain_command(expected)
            except ValueError as error:
                parser.error(f"stored verify command is invalid: {error}")
            if args.then_command != expected or command_args:
                parser.error("verify requires --then with the exact stored command; review it before running")
        if stage in ("install", "verify"):
            plan_groups = [g for g in tracking.get("plan", {}).get("groups", []) if set(ids).intersection(g.get("finding_ids", []))]
            for group in plan_groups:
                stored = group.get("verify", {}).get("command") if isinstance(group.get("verify"), dict) else None
                try:
                    _plain_command(stored if isinstance(stored, str) else "")
                except ValueError as error:
                    parser.error(f"{group.get('id')} verify command is not executable: {error}")
        operations = [{"action":"set-activity","stage":{"fix":"plan_fix","install":"install","verify":"verify"}[stage],"ids":ids,"now":f"{stage.title()} in progress"}]
        if load_override:
            operations[0]["load_override"] = load_override
        if stage in ("install", "verify") and args.model:
            operations[0]["model"] = args.model
        if stage == 'verify':
            verification_started_at = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
            operations[0]['timestamp'] = verification_started_at
            operations[0]['expected_plan_sha256'] = hashlib.sha256(json.dumps(tracking['plan'], sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode('utf-8')).hexdigest()
            expected_document = json.loads(json.dumps(data))
            if rerun_op:
                rerun_op['timestamp'] = verification_started_at
                manage_findings.rerun_verify(expected_document, rerun_op, verification_started_at)
                operations.insert(0, rerun_op)
            for finding in expected_document['findings']:
                if finding['id'] in ids:
                    finding['status'] = 'in_progress'
            manage_findings.start_verification_lanes(expected_document, ids, verification_started_at,
                                                     manage_findings.validate_stage_model(args.model))
            manage_findings.sync_plan_verify(expected_document, ids)
            manage_findings.stamp_changed_stages(data, expected_document, verification_started_at)
            expected_verify_plan = expected_document['tracking']['plan']
            expected_verify_plan_sha256 = manage_findings.plan_candidate_sha256(expected_verify_plan)
    elif stage == "introspect":
        if not args.sections or args.draft: parser.error("introspect requires --sections FILE.json (use --draft FILE.json to prepare an editable draft)")
        payload = json.loads(args.sections.read_text())
        if not isinstance(payload, dict) or set(payload) != {"steps", "none", "sections"}:
            parser.error("introspect file must contain exactly steps, none, and ordered sections")
        try:
            workflow_definition.run_stage_check("introspect", payload["sections"], payload["steps"],
                                                payload["none"], data.get("tracking", {}))
        except ValueError as error:
            parser.error(str(error))
        op = {"action":"introspect", "sections":payload["sections"], "steps":payload["steps"], "none":payload["none"]}
        if args.result: op["result"] = args.result
        ids = args.ids or [x["id"] for x in data.get("findings", []) if x.get("status") == "in_progress"]
        operations = [op,{"action":"set-activity","stage":"introspect","ids":ids,"now":"Introspection recorded"}]
    elif stage == "report":
        operation = {"action":"set-stage","stage":"report_rollover"}
        if args.force:
            operation["override_reason"] = args.reason
        operations = [operation]
    else: parser.error("unknown stage")
    report, base = live_state.report_paths(record, live)
    command = [sys.executable, str(MANAGE), "batch", str(live), "-", "--render", str(report), "--base", str(base)]
    if stage == "report" and args.force: command.append("--force")
    verification_claim = None
    if stage == "verify":
        try:
            verify_driver.self_test()
        except AssertionError as error:
            raise SystemExit(f"Verify driver self-test failed: {error}") from error
        verification_claim = tracker_lock.exclusive_lock(tracker_lock.verify_lock_path(live), blocking=False)
        try:
            verification_claim.__enter__()
        except tracker_lock.LockBusyError:
            raise SystemExit("verification already in progress for this tracker")
        current_run = json.loads(live.read_text()).get("tracking", {}).get("verification_run", {})
        shared = current_run.get("shared_check") if isinstance(current_run, dict) else None
        if not args.shared and isinstance(shared, dict) and shared.get("state") != "passed":
            verification_claim.__exit__(None, None, None)
            verification_claim = None
            parser.error("lane verify requires the shared check to pass first; run bcl verify --shared --then CMD")

    def release_verification_claim():
        nonlocal verification_claim
        if verification_claim is None:
            return
        claim = verification_claim
        try:
            claim.__exit__(None, None, None)
        finally:
            verification_claim = None

    def report_cleanup_failure(cleanup_code):
        if cleanup_code:
            print("Verification cleanup failed; check verdict was recorded independently.", file=sys.stderr)

    try:
        bcl_events.stage_event(live.resolve(), stage, "start", state_dir=os.environ.get("BCL_STATE_DIR"), ids=args.ids)
        result = subprocess.run(command, input=json.dumps(operations), text=True, capture_output=True)
        if result.returncode: sys.stderr.write(result.stderr or result.stdout); raise SystemExit(result.returncode)
        live_state.snapshot(record, live)
        bcl_events.stage_event(live.resolve(), stage, "finish", state_dir=os.environ.get("BCL_STATE_DIR"), ids=args.ids, outcome="completed")
        if rerun_op:
            print(f"Rerunning the check for {', '.join(rerun_op['ids'])}: {args.reason.strip()}")
        if stage == "verify" and args.shared:
            results, cleanup_code = verify_driver.run_round(
                shared=None, lanes=[words], cleanup=release_verification_claim)
            check = results[0]
            code = check.exit_code
            report_cleanup_failure(cleanup_code)
            finished = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
            saved = subprocess.run(command, input=json.dumps([{"action":"finish-shared-check", "run_id":tracking['verification_run']['id'], "exit_code":code, "finished_at":finished}]), text=True, capture_output=True)
            if saved.returncode:
                sys.stderr.write(saved.stderr or saved.stdout)
                raise SystemExit(saved.returncode)
            live_state.snapshot(record, live)
            if code:
                raise SystemExit(code if code > 0 else 128 - code)
            print("Shared checks passed once for this install")
            return
        if record.get("rollover_pending") and begins_collect:
            records = live_state.registry()
            current = records[key]
            current.pop("rollover_pending", None)
            live_state.save_registry(records)
            _ensure_viewer(parser, key, current, live, plugin_version, stage)
        if stage == "verify":
            plan_claim = tracker_lock.exclusive_lock(tracker_lock.plan_lock_path(live))
            plan_claim.__enter__()
            plan_claim_released = False

            def release_plan_claim():
                nonlocal plan_claim_released
                if not plan_claim_released:
                    plan_claim.__exit__(None, None, None)
                    plan_claim_released = True

            try:
                current = json.loads(live.read_text())
                current_tracking = current.get('tracking', {})
                started_plan = current_tracking['plan']
                started_groups = {group['id']: group for group in started_plan['groups']}
                if started_plan != expected_verify_plan or any(group['id'] not in started_groups or
                       started_groups[group['id']].get('finding_ids') != group.get('finding_ids') or
                       started_groups[group['id']].get('verify', {}).get('command') != expected
                       for group in groups) or any(started_plan.get(k) != tracking['plan'].get(k) for k in ('cycle', 'round')):
                    raise SystemExit('plan changed before verification command started; reload and retry')
                try:
                    manage_findings.validate_dependencies(
                        started_plan['groups'], current['findings'], current_tracking)
                except ValueError as error:
                    raise SystemExit(f'verification prerequisites changed before command started: {error}') from error
                results, cleanup_code = verify_driver.run_round(
                    shared=None, lanes=[words], cleanup=release_verification_claim,
                    on_spawn=release_plan_claim)
                check = results[0]
                code = check.exit_code
                report_cleanup_failure(cleanup_code)
                verdict = check.verdict
                reason = f"Verification command exited {code}" if verdict != "passed" else ""
            except OSError as error:
                code = 127
                reason = "Verification command could not start"
                spawn_error = str(error)
            else:
                spawn_error = ""
            finally:
                release_plan_claim()
            if code:
                reason = _verification_failure_reason(expected, reason)
                print(reason, file=sys.stderr)
                recorded = False
                for group in groups:
                    current = json.loads(live.read_text())
                    lane = {"action":"update-plan-group", "id":group['id'],
                        "expected_cycle":started_plan.get('cycle'), "expected_round":started_plan.get('round'),
                        "expected_group":started_groups[group['id']], "patch":{
                        "status":"failed", "phase":"verify",
                        "verify":{**started_groups[group['id']].get('verify', {}), "failure":reason}}}
                    failed = [lane]
                    current_status = {item['id']: item.get('status') for item in current['findings']}
                    run = current['tracking'].get('verification_run', {})
                    for identifier in ids:
                        if identifier not in group.get('finding_ids', []) or current_status.get(identifier) != 'in_progress':
                            continue
                        if run.get('status') == 'active' and run.get('checks', {}).get(identifier, {}).get('state') == 'checking':
                            failed.append({"action":"finish-check", "run_id":run['id'], "id":identifier,
                                           "outcome":"inconclusive", "evidence":reason,
                                           "details":f"Command: {expected}\n{reason}" + (f"\nSpawn error: {spawn_error}" if spawn_error else "")})
                    saved = subprocess.run(command, input=json.dumps(failed), text=True, capture_output=True)
                    if saved.returncode and len(failed) > 1:
                        sys.stderr.write(f"Could not update verification findings for {group['id']}: " + (saved.stderr or saved.stdout))
                        saved = subprocess.run(command, input=json.dumps([lane]), text=True, capture_output=True)
                    if saved.returncode:
                        sys.stderr.write(f"Could not record failed lanes ({group['id']}): " + (saved.stderr or saved.stdout))
                    else:
                        recorded = True
                if recorded:
                    live_state.snapshot(record, live)
                raise SystemExit(code if code > 0 else 128 - code)
            finished = datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
            result = subprocess.run(command, input=json.dumps([{
                "action": "finish-verification", "ids": ids,
                "plan_sha256": expected_verify_plan_sha256,
                "command": expected, "timestamp": finished,
            }]), text=True, capture_output=True)
            if result.returncode:
                sys.stderr.write(result.stderr or result.stdout)
                raise SystemExit(result.returncode)
            live_state.snapshot(record, live)
        elif args.then_command: subprocess.run(args.then_command, shell=True, check=True)
        elif command_args: subprocess.run(command_args, check=True)
        if args.progress:
            args.progress.parent.mkdir(parents=True, exist_ok=True)
            with args.progress.open("a") as out: out.write(f"{stamp} {stage}\n")

    finally:
        release_verification_claim()

if __name__ == "__main__": main()
