#!/usr/bin/env python3
"""Refresh current triage reports and reject stale tracked or staged HTML."""
import json, re, subprocess, sys, tempfile
from pathlib import Path

PLUGIN = Path(__file__).resolve().parents[1]
RENDER = PLUGIN / "skills/batched-change-list/scripts/render.py"

def main():
    root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    triage = root / "docs/triage"
    if not triage.is_dir(): return 0
    for tracker in sorted(triage.glob("*-findings.json")):
        try: url = json.loads(tracker.read_text()).get("tracking", {}).get("pull_request", {}).get("url", "")
        except (OSError, ValueError) as error:
            print(f"bcl-hook: cannot read {tracker}: {error}", file=sys.stderr); return 1
        match = re.search(r"/pull/(\d+)", url)
        if not match: continue
        report = triage / f"pr-{match.group(1)}.html"
        with tempfile.TemporaryDirectory() as temp:
            fresh = Path(temp) / report.name
            proc = subprocess.run([sys.executable, str(RENDER), str(tracker), str(fresh)], capture_output=True, text=True)
            if proc.returncode:
                print((proc.stderr or proc.stdout).strip(), file=sys.stderr); return 1
            expected = fresh.read_bytes()
        if report.exists() and report.read_bytes() != expected: report.write_bytes(expected)
        try:
            indexed = subprocess.run(["git", "-C", str(root), "show", f":{report.relative_to(root)}"], capture_output=True)
            if indexed.returncode == 0 and indexed.stdout != expected:
                print(f"bcl-hook: staged {report.relative_to(root)} is stale; stage the refreshed report", file=sys.stderr); return 1
        except OSError as error:
            print(f"bcl-hook: git check failed: {error}", file=sys.stderr); return 1
    return 0

if __name__ == "__main__": raise SystemExit(main())
