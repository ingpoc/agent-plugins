    "hash_excluded": ["status", "phase", "presuite", "updated_at", "failure_history", "unblock_history", "plan_review_history", "blocked_reason", "failure_block_reason", "verify.status", "verify.fixed", "verify.failed", "verify.total", "verify.failure", "codex.job", "codex.fix_status", "codex.review_status", "codex.plan_review_status", "codex.reviewer_model", "codex.must_fix_note", "codex.tool_fault_streak"],
