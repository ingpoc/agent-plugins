{
  "entry": [
    {"id": "collect", "label": "Collect"},
    {"id": "present", "label": "Present", "hide_after_rollover_until_reached": true}
  ],
  "loop": [
    {"id": "plan_fix", "label": "Plan & fix", "lane_phase": "fix"},
    {"id": "review", "label": "Review", "lane_phase": "review", "check": "review", "activities": ["Terra work-done review", "Pre-push suite"]},
    {"id": "install", "label": "Install", "lane_phase": "install"},
    {"id": "verify", "label": "Verify", "lane_phase": "verify", "requires": ["install"]},
    {"id": "introspect", "label": "Introspect", "lane_phase": "introspect", "requires": ["verify"], "check": "introspect"},
    {"id": "gate", "label": "Gate", "check": "gate"}
  ],
  "exit": [
    {"id": "report_rollover", "label": "Report & roll over", "requires": ["introspect"], "check": "gate"},
    {"id": "merged", "label": "Merge previous PR", "completed_label": "Merged / Done", "requires": ["report_rollover"], "check": "merge_gate"}
  ],
  "gate": {
    "default_threshold": 15,
    "merge_previous_pr_threshold": 16,
    "badge_label": "Fixes",
    "label": "Fixes {fixed}/{threshold} verified",
    "loop_label": "under {threshold} verified · back to Plan & fix",
    "mobile_loop_label": "under {threshold} verified · repeat",
    "exit_label": "Report at {threshold}+ verified",
    "merge_label": "{threshold}+ verified for Merge previous PR",
    "note": "Report at {threshold}+ verified or when no counted findings remain open. Rollover requires at least {merge_threshold}+ verified and the rollover threshold. Merge previous PR requires {merge_threshold}+ verified. No-open exception applies only to report."
  },
  "suggested_verdicts": {},
