    "introspect": {"module": "check_introspect", "function": "validate_introspect", "file": "check_introspect.py"},
    "gate": {"module": "check_gate_count", "function": "gate_count", "file": "check_gate_count.py"},
    "merge_gate": {"module": "check_gate_count", "function": "merge_gate_count", "file": "check_gate_count.py"}
  },
  "transitions": {
    "review": ["plan_fix"],
    "install": ["review"],
    "verify": ["install"],
    "introspect": ["verify"],
    "report_rollover": {"requires": ["introspect"], "when_reached": "install"},
    "merged": ["report_rollover"]
  }
}
