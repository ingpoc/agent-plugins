#!/bin/sh
set -eu

# Thin MCP facade. Cwd-independent. Cursor may spawn plugin-relative ./bin
# against the workspace; Cursor dest mcp.json must use this absolute launcher.
export PYTHONUNBUFFERED=1

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SCRIPT="$ROOT/skills/macos-cua/scripts/compact_mcp.py"
if [ ! -f "$SCRIPT" ]; then
  echo "agent-computer-use: compact MCP script missing at $SCRIPT" >&2
  exit 127
fi

PY="${AGENT_COMPUTER_USE_PYTHON:-}"
if [ -z "$PY" ]; then
  PY=$(command -v python3 2>/dev/null || true)
fi
if [ -z "$PY" ]; then
  PY=$(command -v python 2>/dev/null || true)
fi
if [ -z "$PY" ]; then
  echo "agent-computer-use: python3 not found on PATH" >&2
  exit 127
fi

exec "$PY" -u "$SCRIPT"
