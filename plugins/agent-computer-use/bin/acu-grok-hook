#!/usr/bin/env python3
"""Grok SubagentStart/SubagentStop hook -> island row (https://docs.x.ai/build/features/hooks).

SubagentStart posts a running Grok Bot subagent row. SubagentStop marks it done, or
stopped with a reason. The hook is fail-open, reads no credentials, and never blocks
the agent.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

_SUCCESS = {"completed", "complete", "success", "successful", "done", "ok", "passed"}
_STOP = {"stopped", "cancelled", "canceled", "aborted", "abort", "interrupted", "timeout"}


def _text(value: object, limit: int = 80) -> str:
    if not isinstance(value, str):
        return ""
    return " ".join(value.split())[:limit]


def _first(payload: dict, keys: tuple[str, ...], env_keys: tuple[str, ...] = ()) -> str:
    for key in keys:
        text = _text(payload.get(key), 120)
        if text:
            return text
    for key in env_keys:
        text = _text(os.environ.get(key), 120)
        if text:
            return text
    return ""


def event_name(payload: dict) -> str:
    raw = _first(payload, ("hookEventName", "hook_event_name", "event"),
                 ("GROK_HOOK_EVENT",))
    return re.sub(r"[^A-Za-z]", "", raw).lower()


def row_id(payload: dict) -> str:
    session = _first(payload, ("sessionId", "session_id", "parentSessionId", "parent_session_id"),
                     ("GROK_SESSION_ID",))
    agent = _first(payload, ("subagentId", "subagent_id", "agentId", "agent_id", "id", "agent_type", "type"))
    raw = "-".join(part for part in (session, agent) if part) or "subagent"
    return "subagent-" + re.sub(r"[^A-Za-z0-9_.-]", "", raw)[:60]


def title(payload: dict) -> str:
    for key in ("title", "name", "agent_type", "type", "description", "task", "prompt"):
        text = _text(payload.get(key), 48)
        if text:
            return text
    agent = payload.get("subagent") or payload.get("agent")
    if isinstance(agent, dict):
        for key in ("title", "name", "type"):
            text = _text(agent.get(key), 48)
            if text:
                return text
    return "Grok Bot subagent"


def stop_kind(payload: dict) -> tuple[str, str]:
    status = _first(payload, ("status", "outcome", "result", "state")).lower()
    reason = _text(payload.get("reason") or payload.get("error") or payload.get("message")
                   or payload.get("detail") or payload.get("errorMessage") or payload.get("error_message")
                   or (status if status not in _SUCCESS else ""), 80)
    if status in _SUCCESS and not any(word in reason.lower() for word in ("fail", "error", "abort", "cancel")):
        return "done", ""
    if status in _SUCCESS:
        return "done", ""
    if not status or status in _STOP:
        return "stopped", reason or "Stopped"
    if "fail" in status or "error" in status:
        return "stopped", reason or status or "Stopped with an error"
    return "stopped", reason or status or "Stopped"


def post(*args: str) -> None:
    try:
        subprocess.run([str(HERE / "island-post"), "--source", "grok-bot", *args],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def main() -> int:
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            payload = {}
    except ValueError:
        payload = {}
    name = event_name(payload)
    ident = row_id(payload)
    heading = title(payload)
    if name == "subagentstart":
        post("--kind", "running", "--id", ident, "--app", "Grok Bot", "--title", heading, "--ttl", "1800")
    elif name == "subagentstop" or name == "subagentend":
        kind, reason = stop_kind(payload)
        args = ["--kind", kind, "--id", ident, "--app", "Grok Bot", "--title", heading]
        if reason:
            args.extend(["--detail", reason])
        post(*args)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception:
        raise SystemExit(0)
