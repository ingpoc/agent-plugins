#!/usr/bin/env python3
"""Open the shared Dynamic Island secure field and save metadata to Keychain."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Save a credential entered by the user in Dynamic Island. Metadata only; never pass the value."
    )
    parser.add_argument("--id", required=True, help="stable lowercase locator, for example provider.api_key")
    parser.add_argument("--label", required=True, help="human-readable credential label")
    parser.add_argument("--service", required=True, help="Keychain service")
    parser.add_argument("--account", help="Keychain account; the user can enter it in the form when omitted")
    parser.add_argument("--platform", help="optional platform metadata")
    parser.add_argument("--env", help="optional environment metadata")
    args = parser.parse_args()

    plugin_root = Path(__file__).resolve().parents[1]
    sys.path.insert(0, str(plugin_root / "runtime" / "voice-cua" / "python"))
    from voice_cua.credential_capture import capture_credential

    result = capture_credential({key: value for key, value in vars(args).items() if value is not None})
    print(json.dumps(result, ensure_ascii=True, separators=(",", ":")))
    return 0 if result.get("ok") is True else 1


if __name__ == "__main__":
    raise SystemExit(main())
