#!/usr/bin/env python3
"""Metadata-only Claude Code hooks for Dynamic Island. Always fail open."""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
CACHE = Path.home() / ".cache/macos-cua/claude-hook"
EVENTS = (
    "SessionStart", "UserPromptSubmit", "Notification", "PermissionRequest",
    "Stop", "StopFailure", "SessionEnd",
)


def safe_id(value: object) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]", "", str(value or ""))[:100]


def cache_path(session_id: str) -> Path:
    return CACHE / f"{safe_id(session_id)}.json"


def model_name(slug: object) -> str | None:
    if not isinstance(slug, str):
        return None
    match = re.search(r"claude-(opus|sonnet|haiku)-(\d+)(?:-(\d+))?", slug.lower())
    if not match:
        return None
    version = match.group(2) + (f".{match.group(3)}" if match.group(3) else "")
    return f"{match.group(1).title()} {version}"


def post(session_id: str, *args: str, initiator: str | None = None) -> None:
    command = [
        str(HERE / "island-post"), "--source", "claude",
        "--id", f"claude-code:{session_id}", "--app", "Claude", *args,
    ]
    if initiator:
        raw_initiator = initiator if initiator.startswith("acu_exec.") else f"acu_exec.{initiator}"
        command.extend(("--initiator", raw_initiator))
    try:
        subprocess.run(
            command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=3, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def read_cache(session_id: str) -> dict[str, str]:
    try:
        value = json.loads(cache_path(session_id).read_text())
        return {
            key: value[key]
            for key in ("model", "session_title")
            if isinstance(value.get(key), str)
        }
    except Exception:
        return {}


def atomic_json(path: Path, value: dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(dir=path.parent, prefix=".acu-")
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(value, stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp_path, path)
    finally:
        try:
            os.unlink(temp_path)
        except OSError:
            pass


def hook(payload: dict, initiator: str | None = None) -> None:
    # Deliberately never access prompt or transcript_path.
    event = payload.get("hook_event_name", "")
    session_id = safe_id(payload.get("session_id"))
    if not session_id:
        return

    if event == "SessionStart":
        metadata = read_cache(session_id)
        model = model_name(payload.get("model"))
        if model:
            metadata["model"] = model
        title = payload.get("session_title")
        if isinstance(title, str) and title.strip():
            metadata["session_title"] = title.strip()
        atomic_json(cache_path(session_id), metadata)
    elif event == "UserPromptSubmit":
        cached = read_cache(session_id)
        model = model_name(payload.get("model")) or cached.get("model")
        title = payload.get("session_title")
        if not isinstance(title, str) or not title.strip():
            title = cached.get("session_title")
        if not title:
            title = f"Claude Code · {Path(str(payload.get('cwd') or '.')).name}"
        effort = payload.get("effort")
        effort_level = effort.get("level") if isinstance(effort, dict) else None
        meta = " · ".join(
            value for value in (model, effort_level)
            if isinstance(value, str) and value
        )
        metadata = {"session_title": title}
        if model:
            metadata["model"] = model
        elif cached.get("model"):
            metadata["model"] = cached["model"]
        atomic_json(cache_path(session_id), metadata)
        args = ["--kind", "running", "--title", title, "--ttl", "1800"]
        if meta:
            args.extend(("--meta", meta))
        post(session_id, *args, initiator=initiator)
    elif event == "Notification":
        notification = str(payload.get("notification_type") or "").lower()
        needs_input = notification in {
            "permission_prompt", "elicitation_dialog", "elicitation_url_dialog",
        } or "needs_input" in notification
        if needs_input:
            title = read_cache(session_id).get("session_title") or "Claude Code"
            post(
                session_id, "--kind", "needs_you", "--title", title,
                "--detail", notification.replace("_", " ").capitalize(),
                initiator=initiator,
            )
    elif event == "PermissionRequest":
        title = read_cache(session_id).get("session_title") or "Claude Code"
        post(
            session_id, "--kind", "needs_you", "--title", title,
            "--detail", "Permission requested", initiator=initiator,
        )
    elif event == "Stop":
        title = read_cache(session_id).get("session_title") or "Claude Code"
        post(session_id, "--kind", "done", "--title", title, initiator=initiator)
    elif event == "StopFailure":
        error_type = str(payload.get("error") or "")
        known = {
            "rate_limit": "Rate limited",
            "overloaded": "Overloaded",
            "authentication_failed": "Sign-in failed",
            "billing_error": "Billing",
        }
        detail = known.get(
            error_type,
            " ".join(word.capitalize() for word in re.split(r"[_-]+", error_type))
            or "Turn failed",
        )
        title = read_cache(session_id).get("session_title") or "Claude Code"
        post(
            session_id, "--kind", "error", "--title", title,
            "--detail", detail, initiator=initiator,
        )
    elif event == "SessionEnd":
        post(session_id, "--kind", "clear", initiator=initiator)
        try:
            cache_path(session_id).unlink()
        except OSError:
            pass


def settings_path() -> Path:
    return Path.home() / ".claude/settings.json"


def is_ours(entry: object) -> bool:
    if not isinstance(entry, dict) or entry.get("type") != "command":
        return False
    try:
        parts = shlex.split(entry.get("command", ""))
    except (TypeError, ValueError):
        return False
    if parts and Path(parts[0]).name in {"python", "python3"}:
        parts = parts[1:]
    return bool(parts) and Path(parts[0]).name == "acu-claude-hook"


def without_ours(groups: list) -> list:
    kept = []
    for group in groups:
        if isinstance(group, dict) and isinstance(group.get("hooks"), list):
            foreign = [entry for entry in group["hooks"] if not is_ours(entry)]
            if len(foreign) != len(group["hooks"]):
                if not foreign:
                    continue
                group = dict(group, hooks=foreign)
        kept.append(group)
    return kept


def config_entries() -> list[dict]:
    command = shlex.quote(str(HERE / "acu-claude-hook"))
    return [{"matcher": "", "hooks": [{"type": "command", "command": command, "timeout": 5}]}]


def install() -> None:
    path = settings_path()
    data = json.loads(path.read_text()) if path.exists() else {}
    hooks = data.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("hooks must be an object")
    backup = Path(str(path) + ".acu-bak")
    if path.exists() and not backup.exists():
        backup.write_bytes(path.read_bytes())
    for event in EVENTS:
        groups = hooks.setdefault(event, [])
        if not isinstance(groups, list):
            raise ValueError(f"hooks.{event} must be a list")
        groups[:] = without_ours(groups)
        groups.extend(config_entries())
    atomic_json(path, data)


def uninstall() -> None:
    path = settings_path()
    if not path.exists():
        return
    data = json.loads(path.read_text())
    hooks = data.get("hooks", {})
    if not isinstance(hooks, dict):
        return
    changed = False
    for event in EVENTS:
        groups = hooks.get(event, [])
        if isinstance(groups, list):
            kept = without_ours(groups)
            if kept != groups:
                changed = True
                if kept:
                    hooks[event] = kept
                else:
                    hooks.pop(event, None)
    if not changed:
        return
    if not hooks:
        data.pop("hooks", None)
    atomic_json(path, data)


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--install", action="store_true")
    parser.add_argument("--uninstall", action="store_true")
    parser.add_argument("--initiator")
    args = parser.parse_args()
    if args.install:
        install()
    elif args.uninstall:
        uninstall()
    else:
        try:
            hook(json.load(sys.stdin), args.initiator or os.environ.get("ACU_INITIATOR"))
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    if any(a in ("--install", "--uninstall") for a in sys.argv[1:]):
        # Setup is not a hook: report failure so the installer never thinks it registered.
        try:
            main()
        except Exception as error:
            print(f"acu-claude-hook: {error}", file=sys.stderr)
            raise SystemExit(1)
        raise SystemExit(0)
    try:
        main()
    except (Exception, SystemExit):
        pass
    raise SystemExit(0)
